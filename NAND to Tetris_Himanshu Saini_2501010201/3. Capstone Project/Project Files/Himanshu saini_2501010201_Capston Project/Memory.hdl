// File name: projects/05/Memory.hdl

/**
 * The complete address space of the Hack computer's data memory,
 * including RAM and memory-mapped I/O. 
 * The chip facilitates read and write operations, as follows:
 *     Read:  out(t) = Memory[address(t)](t)
 *     Write: if load(t-1) then Memory[address(t-1)](t) = in(t-1)
 * In words: the chip always outputs the value stored at the memory 
 * location specified by address. If load==1, the in value is loaded 
 * into the memory location specified by address. This value becomes 
 * available through the out output from the next time step onward.
 * Address space rules:
 * Only the upper 16K+8K+1 words of the Memory address space are used. 
 * Access to address>0x6000 is invalid. The behavior in this case is 
 * unspecified.
 *
 * Memory map:
 *   RAM16K  : address[0..13]  =>  0x0000 – 0x3FFF
 *   Screen  : address[13..14] =>  0x4000 – 0x5FFF
 *   Keyboard: address         =>  0x6000
 */

CHIP Memory {

    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[14] = 0 => RAM (0x0000-0x3FFF)
    // address[14] = 1, address[13] = 0 => Screen (0x4000-0x5FFF)
    // address[14] = 1, address[13] = 1 => Keyboard (0x6000)

    // Select RAM or I/O
    DMux(in=load, sel=address[14], a=ramLoad, b=ioLoad);

    // Select Screen or Keyboard within I/O
    DMux(in=ioLoad, sel=address[13], a=screenLoad, b=kbdLoad);

    // RAM16K
    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);

    // Screen (8K)
    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);

    // Keyboard (read-only)
    Keyboard(out=kbdOut);

    // Select output based on address[14] and address[13]
    Mux16(a=screenOut, b=kbdOut, sel=address[13], out=ioOut);
    Mux16(a=ramOut, b=ioOut, sel=address[14], out=out);
}
